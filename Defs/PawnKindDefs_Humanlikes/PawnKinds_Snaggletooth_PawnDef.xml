<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Snaggletooth Default Base -->
  <PawnKindDef Abstract="True" Name="BaseSnaggletoothPawnKind">
    <race>STK_Pawn_Snaggletooth</race>
    <combatPower>30</combatPower>
    <isFighter>false</isFighter>
    <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
    <forceNormalGearQuality>true</forceNormalGearQuality>
  </PawnKindDef>
  
  <!-- Snaggletooth Player Pawn -->
  <PawnKindDef ParentName="BaseSnaggletoothPawnKind">
    <defName>STK_Snaggletooth_Pawn</defName>
    <label>Member</label>
    <race>Pawn_Snaggletooth</race>
    <defaultFactionType>PlayerSnaggletoothIndustrial</defaultFactionType>
    <apparelTags>
      <li>Industrial</li>
    </apparelTags>
    <apparelMoney>200~1000</apparelMoney>
    <backstoryCryptosleepCommonality>1</backstoryCryptosleepCommonality>
    <initialWillRange>1~3</initialWillRange>
    <initialResistanceRange>10~15</initialResistanceRange>
  </PawnKindDef>
  
	<!-- SnaggleSynth Default Base -->
 <PawnKindDef Abstract="True" Name="BaseSnagglesynthPawnKind">
    <race>STK_Pawn_SnaggleSynth</race>
    <combatPower>50</combatPower>
    <isFighter>True</isFighter>
	<backstoryFiltersOverride>
        <li>
            <categories>
                <li>SnaggleSynthBackstory_Child</li>
				<li>SnaggleSynthBackstory_Adult</li>
            </categories>
        </li>
	</backstoryFiltersOverride> 
    <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
    <forceNormalGearQuality>true</forceNormalGearQuality>
  </PawnKindDef>
  
	<!-- SnaggleSynth Player Pawn -->
  <PawnKindDef ParentName="BaseSnagglesynthPawnKind">
    <defName>STK_SnaggleSynth_Pawn</defName>
    <label>Synth</label>
    <race>Pawn_SnaggleSynth</race>
    <defaultFactionType>PlayerSnaggletoothIndustrial</defaultFactionType>
	<combatPower>30</combatPower>
    <apparelTags>
      <li>Industrial</li>
    </apparelTags>
    <apparelMoney>200~2500</apparelMoney>
    <backstoryCryptosleepCommonality>1</backstoryCryptosleepCommonality>
    <initialWillRange>1~3</initialWillRange>
    <initialResistanceRange>50~95</initialResistanceRange>
  </PawnKindDef>

	<!-- SnaggleSynth NPC Unit Base -->
	<PawnKindDef Abstract="True" Name="STR_Snaggletooth_NPC_Pankind">
	<defaultFactionType>KRP_SnaggletoothRaider</defaultFactionType>
    <combatPower>40</combatPower>
    <apparelIgnoreSeasons>True</apparelIgnoreSeasons>
    <forceNormalGearQuality>true</forceNormalGearQuality>
    <label>SnaggleSynth</label>
    <race>Pawn_Snaggletooth</race>
    <apparelTags>
      <li>IndustrialBasic</li>
      <li>IndustrialAdvanced</li>
      <li>IndustrialMilitaryBasic</li>
      <li>IndustrialMilitaryAdvanced</li>
    </apparelTags>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <chemicalAddictionChance>0.0</chemicalAddictionChance>
    <initialWillRange>1~3</initialWillRange>
    <initialResistanceRange>5~7</initialResistanceRange>
    <isFighter>true</isFighter>
    <invNutrition>3</invNutrition>
    <invFoodDef>Pemmican</invFoodDef>
  </PawnKindDef>
  
	<!-- SnaggleTooth NPC Melee -->
   <PawnKindDef ParentName="STR_Snaggletooth_NPC_Pankind">
    <defName>STR_NPC_Melee_Unit</defName>
    <label>Melee</label>
    <combatPower>80</combatPower>
    <itemQuality>Normal</itemQuality>
    <minGenerationAge>25</minGenerationAge>
    <maxGenerationAge>60</maxGenerationAge>
    <apparelMoney>
      <min>500</min>
      <max>750</max>
    </apparelMoney>
    <apparelRequired>
      <li>Apparel_CollarShirt</li>
      <li>Apparel_ShieldBelt</li>
      <li>Apparel_FlakPants</li>
    </apparelRequired>
    <weaponMoney>
      <min>250</min>
      <max>450</max>
    </weaponMoney>
    <weaponTags>
      <li>MedievalMeleeDecent</li>
      <li>MedievalMeleeAdvanced</li>
    </weaponTags>
    <skills>
      <li>
        <skill>Melee</skill>
        <range>5~10</range>
      </li>
    </skills>
    <techHediffsMoney>
      <min>25</min>
      <max>150</max>
    </techHediffsMoney>
    <techHediffsTags>
      <li>Simple</li>
    </techHediffsTags>
    <combatEnhancingDrugsCount>
      <min>0</min>
      <max>1</max>
    </combatEnhancingDrugsCount>
    <inventoryOptions>
      <skipChance>0.8</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>Silver</thingDef>
          <countRange>
            <min>25</min>
            <max>50</max>
          </countRange>
        </li>
        <li>
          <thingDef>MedicineIndustrial</thingDef>
          <countRange>
            <min>0</min>
            <max>1</max>
          </countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
  </PawnKindDef> 
  
