<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- PLAYER SNAGGLETOOTH FACTION-->
	<FactionDef ParentName="FactionBase">
    <defName>PlayerSnaggletoothIndustrial</defName>
    <label>Snaggletooth Outfit</label>
    <description>Snaggletooth Colony</description>
    <isPlayer>true</isPlayer>
	<categoryTag>Tribal</categoryTag>
    <pawnSingular>Snaggletooth</pawnSingular>
    <pawnsPlural>Snaggleteeth</pawnsPlural>
    <basicMemberKind>STK_Snaggletooth_Pawn</basicMemberKind>
    <techLevel>Industrial</techLevel>
	<colorSpectrum>
      <li>(75,109,180)</li>
    </colorSpectrum>
    <backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
      </li>
    </backstoryFilters>
	<allowedCultures Inherit="False">
	<li>Astropolitan</li>
    </allowedCultures>
    <factionIconPath>WorldIcon/SnaggletoothbaseIcon</factionIconPath>
    <settlementTexturePath>WorldIcon/Snaggletooth_Base</settlementTexturePath>
    <playerInitialSettlementNameMaker>NamerInitialSettlementColony</playerInitialSettlementNameMaker>
    <factionNameMaker>NamerFactionTribal</factionNameMaker>
    <settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
	<disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
    </disallowedMemes>
    <disallowedPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Male_CoveringAnythingButGroinDisapproved</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Female_CoveringAnythingButGroinDisapproved</li>
    </disallowedPrecepts>
    <forageabilityFactor>1.7</forageabilityFactor>
    <startingResearchTags>
      <li>ClassicStart</li>
    </startingResearchTags>
    <startingTechprintsResearchTags>
      <li>ClassicStart</li>
      <li>ClassicStartTechprints</li>
    </startingTechprintsResearchTags>
    <apparelStuffFilter>
      <thingDefs>
			<li>Cloth</li>
      </thingDefs>
    </apparelStuffFilter>
    <recipePrerequisiteTags>
      <li>Industrial</li>
    </recipePrerequisiteTags>
    </FactionDef>

	<!-- NPC FACTION SNAGGLETOOTH RAIDER -->
  <FactionDef ParentName="FactionBase">
    <defName>KRP_SnaggletoothRaider</defName>
    <label>Kobold Outfit</label>
    <factionNameMaker>NamerFactionTribal</factionNameMaker>
	<settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
	<description>A Outfit of Snaggletooth Kobolds.</description>
    <factionIconPath>WorldIcon/SnaggletoothbaseIcon</factionIconPath>
    <settlementTexturePath>WorldIcon/Snaggletooth_Base</settlementTexturePath>
    <techLevel>Spacer</techLevel>
    <autoFlee>false</autoFlee>
	<canSiege>false</canSiege>
    <canStageAttacks>true</canStageAttacks>
	<leaderTitle>Leader</leaderTitle>
	<colorSpectrum>
      <li>(153, 204, 51)</li>
    </colorSpectrum>
    <naturalEnemy>true</naturalEnemy>
	<allowedCultures Inherit="False">
	<li>Astropolitan</li>
    </allowedCultures>
	<backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
      </li>
    </backstoryFilters>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
    </requiredMemes>
	<raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
	<settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
	<maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <maxCountAtGameStart>2</maxCountAtGameStart>
    <configurationListOrderPriority>25</configurationListOrderPriority>
	<pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <STR_NPC_Melee_Unit>20</STR_NPC_Melee_Unit>
		  <STR_NPC_Ranger_Unit>50</STR_NPC_Ranger_Unit>
          <STR_NPC_RoboRanger_Unit>40</STR_NPC_RoboRanger_Unit>
		  <STR_NPC_Leader_Unit>5</STR_NPC_Leader_Unit>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <STR_NPC_Melee_Unit>20</STR_NPC_Melee_Unit>
		  <STR_NPC_Ranger_Unit>50</STR_NPC_Ranger_Unit>
          <STR_NPC_RoboRanger_Unit>40</STR_NPC_RoboRanger_Unit>
		  <STR_NPC_Leader_Unit>5</STR_NPC_Leader_Unit>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <STR_NPC_Melee_Unit>20</STR_NPC_Melee_Unit>
		  <STR_NPC_Ranger_Unit>50</STR_NPC_Ranger_Unit>
          <STR_NPC_RoboRanger_Unit>40</STR_NPC_RoboRanger_Unit>
		  <STR_NPC_Leader_Unit>5</STR_NPC_Leader_Unit>
        </options>
      </li>
    </pawnGroupMakers>
	<maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
  </FactionDef>
</Defs>