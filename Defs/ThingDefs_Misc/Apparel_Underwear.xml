<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- Underwear  -->
    <ThingDef ParentName="ApparelMakeableBase">
		<defName>SK_Apparel_Underwear</defName>
		<label>Underwear</label>
		<description>Under garment made from fabric or leather, created to protect the users body fom the elements. Not that it will protect very well, but it is better than wearing nothing at all.</description>
        <comps>
         </comps>
		<graphicData>
			<texPath>Things/Apparel/Underwear/Underwear</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<techLevel>Industrial</techLevel>
		<tradeability>Sellable</tradeability>
        <generateCommonality>0.75</generateCommonality>
		<costStuffCount>40</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<statBases>
		    <MarketValue>300</MarketValue>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToMake>2200</WorkToMake>
			<Mass>0.20</Mass>
			<Beauty>0</Beauty>
			<Flammability>0.2</Flammability>
            <StuffEffectMultiplierArmor>0.10</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.3</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.2</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<SocialImpact>0.05</SocialImpact>
			<WorkSpeedGlobal>0.10</WorkSpeedGlobal>
		</equippedStatOffsets>
    <thingCategories Inherit='False'>
      <li>Apparel</li>
    </thingCategories>
		<apparel>
			<bodyPartGroups>
				<li>Legs</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Apparel/Underwear/Underwear</wornGraphicPath>
			<layers>
				<li>OnSkin</li>
			</layers>
			<tags>
				<li>IndustrialAdvanced</li>
			</tags>
			<defaultOutfitTags>
				<li>Worker</li>
            </defaultOutfitTags>
		</apparel>
		<recipeMaker>
			<researchPrerequisite>ComplexClothing</researchPrerequisite>
						<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>ElectricTailoringBench</li>
				<li>HandTailoringBench</li>
			</recipeUsers>
		</recipeMaker>
    </ThingDef>
	
</Defs>